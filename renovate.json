{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Group HA stubs bump with hacs.json version update",
      "matchPackageNames": ["homeassistant-stubs"],
      "groupName": "home-assistant-version",
      "commitMessageTopic": "Home Assistant minimum version"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["hacs\\.json$"],
      "matchStrings": ["\"homeassistant\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "homeassistant-stubs",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "loose"
    }
  ]
}
